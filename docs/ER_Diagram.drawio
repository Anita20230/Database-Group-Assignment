
cat << 'EOF' > docs/ER_Diagram.drawio
<mxfile>
  <diagram name="Page-1">
    <mxGraphModel>
      <root>
        <!-- Book Table -->
        <mxCell id="book" value="&lt;table style=&quot;width:100%&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; align=&quot;center&quot;&gt;&lt;b&gt;BOOK&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;book_id (PK)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;title&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=table;startSize=30;horizontal=1;fontStyle=1;strokeColor=#000000;">
          <mxGeometry x="100" y="100" width="120" height="90"/>
        </mxCell>
        <!-- More tables... -->
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
EOF